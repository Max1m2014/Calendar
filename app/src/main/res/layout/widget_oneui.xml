<?xml version="1.0" encoding="utf-8"?>
<!-- Samsung One UI style widget: month grid on top, upcoming events below. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/oneui_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/oneui_widget_bg"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="8dp">

    <!-- Header: month + year, arrows, today, add -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/oneui_title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp">

            <TextView
                android:id="@+id/oneui_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/oneui_text"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/oneui_year"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:textColor="@color/oneui_text_secondary"
                android:textSize="15sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/oneui_prev"
            android:layout_width="30dp"
            android:layout_height="36dp"
            android:layout_marginStart="2dp"
            android:contentDescription="@null"
            android:padding="7dp"
            android:src="@drawable/ic_chevron_left_vector"
            android:tint="@color/oneui_text_secondary" />

        <ImageView
            android:id="@+id/oneui_next"
            android:layout_width="30dp"
            android:layout_height="36dp"
            android:contentDescription="@null"
            android:padding="7dp"
            android:src="@drawable/ic_chevron_right_vector"
            android:tint="@color/oneui_text_secondary" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/oneui_today"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@null"
            android:padding="8dp"
            android:src="@drawable/ic_today_vector"
            android:tint="@color/oneui_text"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/oneui_add"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/oneui_button_bg"
            android:contentDescription="@string/new_event"
            android:padding="8dp"
            android:src="@drawable/ic_plus_vector"
            android:tint="@color/oneui_text" />
    </LinearLayout>

    <!-- Weekday labels -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="2dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/oneui_label_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/oneui_text_secondary"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/oneui_label_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/oneui_text_secondary"
            android:textSize="12sp" />
