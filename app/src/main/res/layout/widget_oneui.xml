            android:textSize="12sp" />
        <TextView
            android:id="@+id/oneui_label_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/oneui_text_secondary"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/oneui_label_6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/oneui_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Month grid (6 weeks) -->
