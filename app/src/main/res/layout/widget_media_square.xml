<?xml version="1.0" encoding="utf-8"?>
<!-- Компактный вид 2×2: обложка на весь виджет,
     сверху приложение и название, снизу прогресс и кнопки. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/widget_inset">

    <!-- Сама карточка (отступ вокруг неё = как у папок One UI) -->
    <FrameLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_bg"
        android:clipToOutline="true">

    <!-- Не используется в этом виде, лежит под обложкой (id для общего кода) -->
    <ImageView
        android:id="@+id/bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <!-- Обложка / превью на весь виджет -->
    <ImageView
        android:id="@+id/art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/art_bg"
        android:contentDescription="@string/cd_art"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_art_placeholder" />

    <!-- Затемнения сверху и снизу, чтобы текст и кнопки читались на любой обложке -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_gravity="top"
        android:importantForAccessibility="no"
        android:src="@drawable/scrim_top"
        android:scaleType="fitXY" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:layout_gravity="bottom"
        android:importantForAccessibility="no"
        android:src="@drawable/scrim_bottom"
        android:scaleType="fitXY" />

    <!-- Верх: приложение, название, исполнитель -->
    <LinearLayout
        android:id="@+id/info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/app_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_note" />

            <TextView
                android:id="@+id/app_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="#80000000"
                android:shadowRadius="4"
                android:text="@string/widget_name"
                android:textColor="#D9FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:shadowColor="#80000000"
            android:shadowRadius="4"
            android:text="@string/placeholder_title"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="#80000000"
            android:shadowRadius="4"
            android:text="@string/placeholder_artist"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Низ: тонкий прогресс и кнопки -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/progress_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ProgressBar
                android:id="@+id/progress"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:indeterminate="false"
                android:max="1000"
                android:progress="350"
                android:progressDrawable="@drawable/progress_track" />

            <!-- Время в компактном виде не показываем (id нужны для общего кода) -->
            <TextView
                android:id="@+id/elapsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/prev"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/btn_ripple"
                android:contentDescription="@string/cd_prev"
                android:padding="7dp"
                android:src="@drawable/ic_prev" />

            <ImageView
                android:id="@+id/play"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/play_bg"
                android:contentDescription="@string/cd_play"
                android:padding="9dp"
                android:src="@drawable/ic_play" />

            <ImageView
                android:id="@+id/next"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/btn_ripple"
                android:contentDescription="@string/cd_next"
                android:padding="7dp"
                android:src="@drawable/ic_next" />
        </LinearLayout>
    </LinearLayout>
    </FrameLayout>
</FrameLayout>
